{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "策问修改提案",
  "type": "object",
  "required": [
    "id",
    "title",
    "reason",
    "baseRevision",
    "questionIds",
    "dependencies",
    "changes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
    },
    "title": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "baseRevision": {
      "type": "string"
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "baseHash",
          "text"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(PROJECT\\.md|docs/.+\\.md)$"
          },
          "baseHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
